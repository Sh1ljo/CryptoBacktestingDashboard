@model List<RiskManagement>

@if (Model != null && Model.Count > 0)
{
    <div class="grid grid-3">
        @foreach (var risk in Model)
        {
            <div class="card" style="cursor: pointer;" onclick="window.location.href='@Url.Action("Details", "RiskManagement", new { id = risk.Id })'">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
                    <div style="flex: 1;">
                        <h5 class="card-title">@risk.Name</h5>
                        <p class="card-subtitle" style="margin: 0;">@risk.Type</p>
                    </div>
                </div>

                <p style="color: #505a63; margin-bottom: 1.5rem; min-height: 60px;">
                    @risk.Description
                </p>

                <div style="border-top: 1px solid #c9c9cd; border-bottom: 1px solid #c9c9cd; padding: 1.5rem 0; margin: 1.5rem 0;">
                    <p style="font-size: 12px; color: #8d969e; margin-bottom: 0.3rem; text-transform: uppercase;">Risk Value</p>
                    <p style="font-size: 24px; color: #191c1f; font-weight: 600; margin: 0;">
                        @risk.Value.ToString("F2")%
                    </p>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <p style="font-size: 12px; color: #8d969e; margin-bottom: 0.3rem; text-transform: uppercase;">Used in Strategies</p>
                    <p style="color: #191c1f; font-size: 18px; font-weight: 600; margin: 0;">
                        @(risk.Strategies?.Count ?? 0)
                    </p>
                </div>

                <div style="display: flex; gap: 0.5rem;">
                    <a asp-action="Edit" asp-route-id="@risk.Id" class="btn btn-outlined" style="flex: 1; text-align: center;" onclick="event.stopPropagation();">Edit</a>
                    <form asp-action="Delete" asp-route-id="@risk.Id" method="post" style="flex: 1;" onclick="event.stopPropagation();">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outlined" style="width: 100%; color: #dc3545;" onclick="return confirm('Are you sure you want to delete this risk management profile?')">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <p style="color: #8d969e; font-size: 18px;">No risk management profiles configured yet.</p>
    </div>
}
