@model IEnumerable<CryptoBacktestingDashboard.Models.Crypto.Attachment>

@if (!Model.Any())
{
    <p class="text-muted">Nema uploadanih datoteka.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Datoteka</th>
                <th>Veličina</th>
                <th>Akcija</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attachment in Model)
            {
                <tr>
                    <td>
                        <a href="@attachment.FilePath" target="_blank">@attachment.FileName</a>
                    </td>
                    <td>@(attachment.FileSize / 1024) KB</td>
                    <td>
                        <button type="button" class="btn btn-outline btn-sm text-danger" onclick="deleteAttachment(@attachment.Id)">
                            Obriši
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}