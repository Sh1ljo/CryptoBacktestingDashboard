@model List<Indicator>
@{
    var _curPage = (int?)ViewData["CurrentPage"] ?? 0;
    var _totPages = (int?)ViewData["TotalPages"] ?? 0;
    var _totCount = (int?)ViewData["TotalCount"] ?? 0;
}

@if (Model != null && Model.Count > 0)
{
    <div class="grid grid-3">
        @foreach (var indicator in Model)
        {
            <div class="card" style="cursor: pointer;" onclick="window.location.href='@Url.Action("Details", "Indicator", new { id = indicator.Id })'">
                <h5 class="card-title">@indicator.Name</h5>
                <p class="card-subtitle" style="margin-bottom: 1rem;">@indicator.Type</p>

                <p style="color: #505a63; margin-bottom: 1.5rem; min-height: 50px;">
                    @indicator.Description
                </p>

                <div style="border-top: 1px solid #c9c9cd; border-bottom: 1px solid #c9c9cd; padding: 1.5rem 0; margin: 1.5rem 0;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div>
                            <p style="font-size: 12px; color: #8d969e; margin-bottom: 0.3rem; text-transform: uppercase;">Period</p>
                            <p style="color: #191c1f; font-size: 18px; font-weight: 600; margin: 0;">@indicator.Period</p>
                        </div>
                        <div>
                            <p style="font-size: 12px; color: #8d969e; margin-bottom: 0.3rem; text-transform: uppercase;">Threshold</p>
                            <p style="color: #191c1f; font-size: 18px; font-weight: 600; margin: 0;">@indicator.Threshold</p>
                        </div>
                    </div>
                </div>

                <p style="font-size: 12px; color: #8d969e; margin-bottom: 0.5rem; text-transform: uppercase;">
                    Used in @(indicator.Strategies?.Count ?? 0) strateg@((indicator.Strategies?.Count ?? 0) == 1 ? "y" : "ies")
                </p>

                <div style="display: flex; gap: 0.5rem;">
                    <a asp-action="Edit" asp-route-id="@indicator.Id" class="btn btn-outlined" style="flex: 1; text-align: center;" onclick="event.stopPropagation();">Edit</a>
                    <form asp-action="Delete" asp-route-id="@indicator.Id" method="post" style="flex: 1;" onclick="event.stopPropagation();">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outlined" style="width: 100%; color: #dc3545;" onclick="return confirm('Are you sure you want to delete this indicator?')">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>

    @if (_totPages > 1)
    {
        <div class="pagination">
            <button class="pagination-btn" onclick="loadPage(@(_curPage - 1))" @(_curPage <= 1 ? "disabled" : "")>←</button>
            @for (var p = 1; p <= _totPages; p++)
            {
                <button class="pagination-btn @(p == _curPage ? "active" : "")" onclick="loadPage(@p)">@p</button>
            }
            <button class="pagination-btn" onclick="loadPage(@(_curPage + 1))" @(_curPage >= _totPages ? "disabled" : "")>→</button>
            <span class="pagination-info">@_totCount total</span>
        </div>
    }
}
else
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <p style="color: #8d969e; font-size: 18px;">No indicators configured yet.</p>
    </div>
}
