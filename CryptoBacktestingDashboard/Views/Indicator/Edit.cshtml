@model CryptoBacktestingDashboard.Models.Crypto.Indicator

@{
    ViewData["Title"] = "Edit Indicator";
}

<div class="page-hero">
    <h1 class="page-hero__title">Edit Technical Indicator</h1>
    <p class="page-hero__subtitle">Update the indicator configuration.</p>
</div>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-shell">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />

        <div class="grid grid-2 form-grid">
            <div class="form-group">
                <label asp-for="Name" class="form-label">Indicator Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g., RSI 14" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Type" class="form-label">Indicator Type</label>
                <select asp-for="Type" class="form-control">
                    <option value="">-- Select Type --</option>
                    <option value="RSI">RSI (Relative Strength Index)</option>
                    <option value="MACD">MACD (Moving Average Convergence Divergence)</option>
                    <option value="MovingAverage">Moving Average</option>
                    <option value="BollingerBands">Bollinger Bands</option>
                    <option value="Stochastic">Stochastic</option>
                    <option value="ATR">ATR (Average True Range)</option>
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
                <small id="typeNote" class="form-help"></small>
            </div>
        </div>

        <div class="grid grid-2 form-grid">
            <div class="form-group">
                <label id="periodLabel" asp-for="Period" class="form-label">Period (candles)</label>
                <input asp-for="Period" class="form-control" type="number" min="1" />
                <small id="periodHelp" class="form-help">Pick an indicator type above to see what this means.</small>
                <span asp-validation-for="Period" class="text-danger"></span>
            </div>

            <div id="thresholdGroup" class="form-group">
                <label id="thresholdLabel" asp-for="Threshold" class="form-label">Threshold Value</label>
                <input asp-for="Threshold" class="form-control" type="number" step="0.01" />
                <small id="thresholdHelp" class="form-help">Meaning depends on the indicator type.</small>
                <span asp-validation-for="Threshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group form-block">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe this indicator configuration..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <hr class="form-divider" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Update Indicator</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/indicator-form.js" asp-append-version="true"></script>
}
