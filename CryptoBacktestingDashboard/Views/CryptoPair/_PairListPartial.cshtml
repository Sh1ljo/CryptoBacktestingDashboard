@model List<CryptoPair>

@{
    var priceChanges = ViewData["PriceChanges"] as Dictionary<int, decimal?>;
}

@if (Model != null && Model.Count > 0)
{
    <div class="grid grid-3">
        @foreach (var pair in Model)
        {
            decimal priceChangePercent = 0;
            if (priceChanges != null && priceChanges.ContainsKey(pair.Id))
            {
                priceChangePercent = priceChanges[pair.Id] ?? 0;
            }

            <div class="card" style="cursor: pointer;" onclick="window.location.href='@Url.Action("Details", "CryptoPair", new { id = pair.Id })'">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
                    <div>
                        <h5 class="card-title">@pair.Symbol</h5>
                        <p class="card-subtitle" style="margin: 0;">@pair.BaseAsset / @pair.QuoteAsset</p>
                    </div>
                    <span class="badge badge-info">
                        Live
                    </span>
                </div>

                <div style="background: #f4f4f4; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; text-align: center;">
                    <p style="font-size: 12px; color: #8d969e; margin: 0 0 0.5rem 0; text-transform: uppercase;">
                        Current Price
                    </p>
                    <p style="font-size: 28px; color: #191c1f; font-weight: 600; margin: 0;">
                        $@(pair.CurrentPrice?.ToString("F2") ?? "0.00")
                    </p>
                    <p style="font-size: 12px; color: @(priceChangePercent > 0 ? "#00a87e" : "#e23b4a"); margin: 0.5rem 0 0 0;">
                        ↑ @priceChangePercent.ToString("+0.0;-0.0;0")%
                    </p>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #c9c9cd;">
                    <div class="metric">
                        <div class="metric-value">@(pair.CandleDataHistory?.Count ?? 0)</div>
                        <div class="metric-label">Candles</div>
                    </div>
                    <div class="metric">
                        <div class="metric-value">@(pair.BacktestSessions?.Count ?? 0)</div>
                        <div class="metric-label">Backtests</div>
                    </div>
                </div>

                <p style="font-size: 12px; color: #8d969e; margin-bottom: 0.5rem; text-transform: uppercase;">
                    Added
                </p>
                <p style="color: #505a63; margin-bottom: 1.5rem;">
                    @pair.CreatedAt.ToString("MMM dd, yyyy")
                </p>

                <div style="display: flex; gap: 0.5rem;">
                    <a asp-action="Edit" asp-route-id="@pair.Id" class="btn btn-outlined" style="flex: 1; text-align: center;" onclick="event.stopPropagation();">Edit</a>
                    <form asp-action="Delete" asp-route-id="@pair.Id" method="post" style="flex: 1;" onclick="event.stopPropagation();">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outlined" style="width: 100%; color: #dc3545;" onclick="return confirm('Are you sure you want to delete this pair?')">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <p style="color: #8d969e; font-size: 18px;">No crypto pairs configured yet.</p>
    </div>
}
