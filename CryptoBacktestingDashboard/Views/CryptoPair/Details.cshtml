@model CryptoPair

@{
    ViewData["Title"] = $"Pair: {Model.Symbol}";
    var candlesForChart = Model.CandleDataHistory?
        .OrderBy(c => c.OpenTime)
        .Select(c => new {
            time = c.OpenTime.ToString("yyyy-MM-dd"),
            open = c.Open,
            high = c.High,
            low = c.Low,
            close = c.Close
        }).ToList();
    var hasCandles = candlesForChart != null && candlesForChart.Count > 0;
}

<nav class="breadcrumbs">
    <a asp-action="Index" asp-controller="CryptoPair">Pairs</a>
    <span>/</span>
    <span>@Model.Symbol</span>
</nav>

<section>
    <div class="detail-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem;">
        <div>
            <h2>@Model.Symbol</h2>
            <p style="font-size: 18px; color: var(--rui-mid-slate); margin: 0;">@Model.BaseAsset / @Model.QuoteAsset trading pair</p>
        </div>
        <span class="badge badge-success">Live</span>
    </div>
</section>

<section>
    <h3>Market Data</h3>
    <div class="grid grid-2">
        <div class="card">
            <h6>Current Price</h6>
            <div style="display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap;">
                <div class="metric-value" style="font-size: 48px; margin: 0;">
                    $@(Model.CurrentPrice?.ToString("F2") ?? "0.00")
                </div>
                @{
                    var priceChange = ViewData["PriceChangePercentage"] as decimal?;
                    var priceChangeString = priceChange.HasValue ? $"{priceChange.Value:F2}%" : "0.00%";
                    var priceChangeColor = priceChange.HasValue && priceChange > 0 ? "#00a87e" : "#e23b4a";
                }
                <span style="color: @priceChangeColor; font-size: 14px; font-weight: 600;">↑ @priceChangeString</span>
            </div>
        </div>

        <div class="card">
            <h6>Trading Information</h6>
            <p style="margin: 0.5rem 0; color: var(--rui-mid-slate);"><strong>Base Asset:</strong> @Model.BaseAsset</p>
            <p style="margin: 0.5rem 0; color: var(--rui-mid-slate);"><strong>Quote Asset:</strong> @Model.QuoteAsset</p>
            <p style="margin: 0; color: var(--rui-mid-slate);"><strong>Added:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy")</p>
        </div>
    </div>
</section>

@if (hasCandles)
{
    <section>
        <h3>Price Chart</h3>
        <div class="card chart-card">
            <div id="pairPriceChart" style="height: 380px;"></div>
        </div>
    </section>
}

<section>
    <div class="detail-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="margin: 0;">Candle Data History</h3>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <form asp-action="FetchData" asp-route-id="@Model.Id" method="post" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary" style="font-size: 12px; padding: 8px 16px;">
                    Fetch 1 Year of Data
                </button>
            </form>
            @if (Model.CandleDataHistory != null && Model.CandleDataHistory.Count > 0)
            {
                <form asp-action="ClearData" asp-route-id="@Model.Id" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outlined" style="font-size: 12px; padding: 8px 16px; color: #e23b4a; border-color: #e23b4a;" onclick="return confirm('Clear all candle data for this pair?')">
                        Clear Data
                    </button>
                </form>
            }
        </div>
    </div>
    @if (Model.CandleDataHistory != null && Model.CandleDataHistory.Count > 0)
    {
        <table>
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Open</th>
                    <th>High</th>
                    <th>Low</th>
                    <th>Close</th>
                    <th>Volume</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candle in Model.CandleDataHistory.OrderByDescending(c => c.OpenTime).Take(20))
                {
                    <tr>
                        <td>@candle.OpenTime.ToString("MMM dd, yyyy")</td>
                        <td>$@candle.Open.ToString("F2")</td>
                        <td>$@candle.High.ToString("F2")</td>
                        <td>$@candle.Low.ToString("F2")</td>
                        <td style="font-weight: 600;">$@candle.Close.ToString("F2")</td>
                        <td>@candle.Volume.ToString("F0")</td>
                    </tr>
                }
            </tbody>
        </table>
        <p style="color: var(--rui-cool-gray); font-size: 12px; text-align: center;">
            Showing latest 20 of @Model.CandleDataHistory.Count candles
        </p>
    }
    else
    {
        <div class="card" style="padding: 2rem; text-align: center;">
            <p style="color: var(--rui-cool-gray); margin-bottom: 1rem;">No candle data available. Click "Fetch 1 Year of Data" to load historical prices from Binance.</p>
        </div>
    }
</section>

<section>
    <h3>Backtest History</h3>
    @if (Model.BacktestSessions != null && Model.BacktestSessions.Count > 0)
    {
        <table>
            <thead>
                <tr>
                    <th>Strategy</th>
                    <th>Period</th>
                    <th>Profit/Loss</th>
                    <th>ROI</th>
                    <th>Trades</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Model.BacktestSessions)
                {
                    var sessionProfit = session.GetProfit();
                    var sessionRoi = session.GetROI();
                    var sessionColor = sessionProfit >= 0 ? "#00a87e" : "#e23b4a";
                    <tr>
                        <td>
                            <a asp-controller="BacktestStrategy" asp-action="Details" asp-route-id="@session.StrategyId">
                                @session.Strategy?.Name
                            </a>
                        </td>
                        <td>@session.StartDate.ToString("MMM dd") - @session.EndDate.ToString("MMM dd")</td>
                        <td style="color: @sessionColor; font-weight: 600;">$@Math.Abs(sessionProfit).ToString("F2")</td>
                        <td style="color: @sessionColor; font-weight: 600;">@sessionRoi.ToString("F1")%</td>
                        <td>@session.Results.Count</td>
                        <td>
                            <a asp-controller="BacktestSession" asp-action="Details" asp-route-id="@session.Id" class="btn btn-secondary" style="font-size: 12px; padding: 0.4rem 0.8rem;">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="card" style="padding: 2rem; text-align: center;">
            <p style="color: var(--rui-cool-gray); margin: 0;">No backtest sessions for this pair yet.</p>
        </div>
    }
</section>

<section class="detail-header" style="display: flex; gap: 1rem;">
    <a asp-action="Index" class="btn btn-outlined">← Back to Pairs</a>
</section>

@if (hasCandles)
{
    @section Scripts {
        <script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
        <script>
            (function () {
                var container = document.getElementById('pairPriceChart');
                if (!container || typeof LightweightCharts === 'undefined') return;

                var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                var textColor = isDark ? '#a0abb5' : '#505a63';
                var gridColor = isDark ? '#2e343c' : '#e8eaed';

                var chart = LightweightCharts.createChart(container, {
                    width: container.clientWidth,
                    height: 380,
                    layout: {
                        background: { type: 'solid', color: 'transparent' },
                        textColor: textColor
                    },
                    grid: {
                        vertLines: { color: gridColor },
                        horzLines: { color: gridColor }
                    },
                    rightPriceScale: { borderColor: gridColor },
                    timeScale: { borderColor: gridColor, timeVisible: true }
                });

                var candleSeries = chart.addCandlestickSeries({
                    upColor: '#00a87e',
                    downColor: '#e23b4a',
                    borderVisible: false,
                    wickUpColor: '#00a87e',
                    wickDownColor: '#e23b4a'
                });

                var candles = @Json.Serialize(candlesForChart);
                candleSeries.setData(candles);
                chart.timeScale().fitContent();

                new ResizeObserver(function () {
                    chart.applyOptions({ width: container.clientWidth });
                }).observe(container);
            })();
        </script>
    }
}
