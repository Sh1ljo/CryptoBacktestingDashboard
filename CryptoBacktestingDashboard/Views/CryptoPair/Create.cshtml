@model CryptoBacktestingDashboard.Models.Crypto.CryptoPair

@{
    ViewData["Title"] = "Create Crypto Pair";
}

<div class="page-hero">
    <h1 class="page-hero__title">Add New Trading Pair</h1>
    <p class="page-hero__subtitle">Configure a new cryptocurrency pair for backtesting.</p>
</div>

<div class="form-card">
    <form asp-action="Create" method="post" class="form-shell">

        <div class="grid grid-2 form-grid">
            <div class="form-group">
                <label asp-for="Symbol" class="form-label">Symbol (e.g., BTC/USD)</label>
                <input asp-for="Symbol" class="form-control" placeholder="BTC/USD" />
                <span asp-validation-for="Symbol" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CurrentPrice" class="form-label">Current Price ($)</label>
                <input asp-for="CurrentPrice" class="form-control" type="number" step="any" placeholder="Leave 0 if not yet fetched" />
                <span asp-validation-for="CurrentPrice" class="text-danger"></span>
            </div>
        </div>

        <div class="grid grid-2 form-grid">
            <div class="form-group">
                <label asp-for="BaseAsset" class="form-label">Base Asset (e.g., BTC)</label>
                <input asp-for="BaseAsset" class="form-control" placeholder="BTC" />
                <span asp-validation-for="BaseAsset" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="QuoteAsset" class="form-label">Quote Asset (e.g., USD)</label>
                <input asp-for="QuoteAsset" class="form-control" placeholder="USD" />
                <span asp-validation-for="QuoteAsset" class="text-danger"></span>
            </div>
        </div>

        <hr class="form-divider" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Pair</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
