@model CryptoBacktestingDashboard.Models.Crypto.BacktestSession

@{
    ViewData["Title"] = "Edit Backtest Session";
}

<div class="page-hero">
    <h1 class="page-hero__title">Edit Backtest Session</h1>
    <p class="page-hero__subtitle">Update simulation variables</p>
</div>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-shell">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExecutedAt" />

        <div class="grid grid-2 form-grid">

            <!-- Autocomplete Dropdown for Strategy -->
            <div class="form-group">
                <partial name="_AutocompleteDropdownPartial" model='new CryptoBacktestingDashboard.Models.AutocompleteViewModel {
                    PropertyName = "StrategyId",
                    DisplayName = "Strategy",
                    SearchUrl = Url.Action("Search", "BacktestStrategy"),
                    InitialText = Model.Strategy?.Name ?? Model.StrategyId.ToString(),
                    InitialValue = Model.StrategyId
                }' />
            </div>

            <!-- Autocomplete Dropdown is styled inside its partial -->
            <div class="form-group">
                <partial name="_AutocompleteDropdownPartial" model='new CryptoBacktestingDashboard.Models.AutocompleteViewModel {
                    PropertyName = "CryptoPairId",
                    DisplayName = "Crypto Pair",
                    SearchUrl = Url.Action("Search", "CryptoPair"),
                    InitialText = Model.CryptoPair?.Symbol ?? Model.CryptoPairId.ToString(),
                    InitialValue = Model.CryptoPairId
                }' />
            </div>
        </div>

        <div class="grid grid-2 form-grid">
            <div class="form-group">
                @{ ViewData["Label"] = "Start Date"; }
                <partial name="_DatepickerPartial" for="StartDate" />
            </div>

            <div class="form-group">
                @{ ViewData["Label"] = "End Date"; }
                <partial name="_DatepickerPartial" for="EndDate" />
            </div>
        </div>

        <hr class="form-divider" />

        <div class="form-group form-block">
            <label asp-for="InitialBalance" class="form-label">Initial Balance ($)</label>
            <input asp-for="InitialBalance" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="InitialBalance" class="text-danger"></span>
            <small class="form-help">Final balance will be calculated when you run the backtest.</small>
        </div>

        <div class="form-callout form-block-lg">
            <div class="form-toggle">
                <input asp-for="IsOptimized" class="form-check-input" />
                <label asp-for="IsOptimized" class="form-label">Enable algorithmic optimizations on this run</label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Update Session</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

