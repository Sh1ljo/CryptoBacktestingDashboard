@model CryptoBacktestingDashboard.Models.Crypto.BacktestSession

@{
    ViewData["Title"] = "Create Backtest Session";
}

<div class="page-hero">
    <h1 class="page-hero__title">Create Backtest Session</h1>
    <p class="page-hero__subtitle">Configure rules and parameters for a new simulation.</p>
</div>

<div class="form-card">
    <form asp-action="Create" method="post" class="form-shell">

        <div class="grid grid-2 form-grid">

            <!-- Autocomplete Dropdown for Strategy -->
            <div class="form-group">
                <partial name="_AutocompleteDropdownPartial" model='new CryptoBacktestingDashboard.Models.AutocompleteViewModel {
                    PropertyName = "StrategyId",
                    DisplayName = "Strategy",
                    SearchUrl = Url.Action("Search", "BacktestStrategy"),
                    InitialText = "",
                    InitialValue = null
                }' />
            </div>

            <!-- Autocomplete Dropdown is styled inside its partial -->
            <div class="form-group">
                <partial name="_AutocompleteDropdownPartial" model='new CryptoBacktestingDashboard.Models.AutocompleteViewModel {
                    PropertyName = "CryptoPairId",
                    DisplayName = "Crypto Pair",
                    SearchUrl = Url.Action("Search", "CryptoPair"),
                    InitialText = "",
                    InitialValue = null
                }' />
                <div id="pairDataStatus" style="display: none; margin-top: 0.5rem;"></div>
            </div>
        </div>

        <div class="grid grid-2 form-grid">
            <!-- Start Date with Partial View -->
            <div class="form-group">
                @{ ViewData["Label"] = "Start Date"; }
                <partial name="_DatepickerPartial" for="StartDate" />
            </div>

            <!-- End Date with Partial View -->
            <div class="form-group">
                @{ ViewData["Label"] = "End Date"; }
                <partial name="_DatepickerPartial" for="EndDate" />
            </div>
        </div>

        <hr class="form-divider" />

        <div class="form-group form-block">
            <label asp-for="InitialBalance" class="form-label">Initial Balance ($)</label>
            <input asp-for="InitialBalance" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="InitialBalance" class="text-danger"></span>
            <small class="form-help">This will be used as your starting capital. Final balance will be calculated when you run the backtest.</small>
        </div>

        <div class="form-callout form-block-lg">
            <div class="form-toggle">
                <input asp-for="IsOptimized" class="form-check-input" />
                <label asp-for="IsOptimized" class="form-label">Enable algorithmic optimizations on this run</label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Session</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // When a pair is chosen, check whether it has candle data and warn early so the
        // user fetches data before running (instead of hitting "not enough candle data").
        $(function () {
            var hidden = $('#CryptoPairId');
            var box = $('#pairDataStatus');

            function render(html, cls) {
                box.attr('class', 'alert ' + cls)
                   .css({ display: 'block', padding: '0.75rem 1rem', 'border-radius': '8px' })
                   .html(html);
            }

            hidden.on('change', function () {
                var id = $(this).val();
                if (!id) { box.hide(); return; }

                $.getJSON('/pairs/' + id + '/data-status')
                    .done(function (s) {
                        if (!s.hasData) {
                            render('⚠ This pair has <strong>no historical data</strong>. ' +
                                   'Open the pair and click <em>Fetch Data</em> before running a backtest. ' +
                                   '<a href="/pairs/' + id + '" target="_blank">Open pair →</a>',
                                   'alert-danger');
                        } else {
                            render('✓ ' + s.count + ' candles available (' + s.earliest +
                                   ' → ' + s.latest + '). Keep your date range within this window.',
                                   'alert-success');
                        }
                    })
                    .fail(function () { box.hide(); });
            });
        });
    </script>
}

