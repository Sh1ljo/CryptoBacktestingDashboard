<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Crypto Backtesting Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <span class="navbar-brand">CryptoBacktestingDashboard</span>
            <div style="flex-grow: 1;"></div>
            <ul class="nav-links">
                <li><a asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                <li><a asp-area="" asp-controller="BacktestSession" asp-action="Index">Sessions</a></li>
                <li><a asp-area="" asp-controller="BacktestStrategy" asp-action="Index">Strategies</a></li>
                <li><a asp-area="" asp-controller="CryptoPair" asp-action="Index">Pairs</a></li>
                <li><a asp-area="" asp-controller="Indicator" asp-action="Index">Indicators</a></li>
                <li><a asp-area="" asp-controller="RiskManagement" asp-action="Index">Risk</a></li>
            </ul>
        </nav>
    </header>
    
    <main>
        @if (TempData["Success"] != null)
        {
            <div style="background: #00a87e; color: white; padding: 12px 24px; border-radius: 12px; margin-bottom: 1rem; font-size: 14px;">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div style="background: #e23b4a; color: white; padding: 12px 24px; border-radius: 12px; margin-bottom: 1rem; font-size: 14px;">
                @TempData["Error"]
            </div>
        }
        @RenderBody()
    </main>

    <footer style="border-top: 1px solid #c9c9cd; padding: 2rem 1rem; text-align: center; color: #505a63; margin-top: 5rem;">
        <p>&copy; 2026 Crypto Backtesting Dashboard - Lab 2</p>
    </footer>

    <!-- jQuery and Bootstrap (required for Validation and AJAX to run correctly) -->
    <script src="https://ajax.aspnetcdn.com/ajax/jquery/jquery-3.6.0.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
