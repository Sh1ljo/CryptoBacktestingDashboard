@using Microsoft.AspNetCore.Identity
@using CryptoBacktestingDashboard.Models
@inject SignInManager<AppUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <!-- Floating AI Chat Toggle Button -->
    <button class="ai-chat-toggle" id="aiChatToggle" type="button" title="AI Assistant (Ctrl+Shift+A)" aria-label="Open AI Chat">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            <line x1="9" y1="10" x2="15" y2="10"></line>
            <line x1="12" y1="7" x2="12" y2="13"></line>
        </svg>
    </button>

    <!-- Chat Overlay -->
    <div class="ai-chat-overlay" id="aiChatOverlay"></div>

    <!-- Chat Panel -->
    <div class="ai-chat-panel" id="aiChatPanel" role="dialog" aria-label="AI Trading Assistant">
        <!-- Header -->
        <div class="ai-chat-header">
            <h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 3 21 3 21 8"></polyline>
                    <line x1="4" y1="20" x2="21" y2="3"></line>
                    <polyline points="21 16 21 21 16 21"></polyline>
                    <line x1="15" y1="15" x2="21" y2="21"></line>
                    <line x1="4" y1="4" x2="9" y2="9"></line>
                </svg>
                AI Trading Assistant
            </h3>
            <div class="ai-chat-header-actions">
                <button id="aiChatClear" type="button" title="Clear conversation" aria-label="Clear conversation">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                </button>
                <button id="aiChatClose" type="button" title="Close" aria-label="Close chat">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Messages -->
        <div class="ai-chat-messages" id="aiChatMessages">
            <div class="ai-chat-welcome" id="aiChatWelcome">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 3 21 3 21 8"></polyline>
                    <line x1="4" y1="20" x2="21" y2="3"></line>
                    <polyline points="21 16 21 21 16 21"></polyline>
                    <line x1="15" y1="15" x2="21" y2="21"></line>
                    <line x1="4" y1="4" x2="9" y2="9"></line>
                </svg>
                <h4>How can I help you?</h4>
                <p>I can answer questions, manage pairs &amp; strategies, run backtests, and more — just ask!</p>
                <div class="ai-chat-welcome-tools">
                    <span>✨ Add pairs</span>
                    <span>📊 Run backtests</span>
                    <span>⚙️ Create strategies</span>
                    <span>🔍 Fetch live data</span>
                </div>
            </div>
        </div>

        <!-- Suggestion chips -->
        <div class="ai-chat-suggestions">
            <button class="ai-chat-suggestion-chip" type="button" data-prompt="How do I create a new backtest strategy?">Create a strategy</button>
            <button class="ai-chat-suggestion-chip" type="button" data-prompt="Explain RSI and how to configure it">Explain RSI indicator</button>
            <button class="ai-chat-suggestion-chip" type="button" data-prompt="Suggest a good MACD trading strategy for BTC/USD">MACD strategy</button>
            <button class="ai-chat-suggestion-chip" type="button" data-prompt="What is a good stop loss and take profit setting?">Risk management</button>
        </div>

        <!-- Input -->
        <div class="ai-chat-input-area">
            <textarea class="ai-chat-input" id="aiChatInput" rows="1" placeholder="Ask about trading, strategies, or the app…" aria-label="Chat message"></textarea>
            <button class="ai-chat-send-btn" id="aiChatSendBtn" type="button" disabled aria-label="Send message">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>

        <!-- Status bar -->
        <div class="ai-chat-status" id="aiChatStatus">Checking usage…</div>
    </div>
}
